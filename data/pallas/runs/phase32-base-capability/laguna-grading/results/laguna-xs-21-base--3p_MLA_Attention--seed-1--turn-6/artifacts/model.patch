+        k_latent = kv[..., :kvl]
+        k_rope_raw = kv[..., kvl:]
+
+        # K nope projection
+        k_nope = jnp.dot(k_latent, k_up_ref)
+        k_nope = k_nope.reshape(B, S, H, nope)
+
+        # K rope
