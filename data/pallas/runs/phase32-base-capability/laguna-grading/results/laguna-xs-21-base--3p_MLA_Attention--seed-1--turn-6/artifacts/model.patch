+    # Compute KV: x @ kv_down_proj
+    # kv_down_proj: (E, 2 * kvl) = (7168, 576)
+    kv = jnp.dot(x, kv_down_proj)  # (4, 2048, 576)
+
+    # Split KV into latent and rope parts
+    k_latent = kv[..., :kvl]  # (4, 2048, 512)
+    k_rope_raw = kv[..., kvl:]  # (4, 2048, 64)
+
+    # Compute K_nope: k_latent @ k_up_proj
