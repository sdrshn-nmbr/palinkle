+    # q_up_proj: (q_lora_rank, H * hd) = (1536, 24576)
+    q = jnp.dot(x, q_down_proj)  # (4, 2048, 1536)
+    q = jnp.dot(q, q_up_proj)  # (4, 2048, 24576)
+    q = q.reshape(B, S, H, hd)  # (4, 2048, 128, 192)
+
+    # Split Q into nope and rope parts
+    q_nope = q[..., :nope]  # (4, 2048, 128, 128)
+    q_rope = q[..., nope:]  # (4, 2048, 128, 64)
