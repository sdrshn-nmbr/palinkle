+def _compute_rope(head_dim, seq_len, theta, dtype):
+    """Compute cosine and sine tables for RoPE."""
+    freqs = 1.0 / (theta ** (jnp.arange(0, head_dim, 2) / head_dim))
+    pos = jnp.arange(seq_len)
+    angles = jnp.outer(pos, freqs)
+    return jnp.cos(angles).astype(dtype), jnp.sin(angles).astype(dtype)
+
+
+def _apply_rope(x, cos, sin):
+    """Apply RoPE to input tensor."""
+    x1 = x[..., ::2]
+    x2 = x[..., 1::2]
+    rotated = jnp.stack([
+        x1 * cos - x2 * sin,
+        x1 * sin + x2 * cos
+    ], axis=-1)
+    return rotated.reshape(x.shape[:-2] + (rotated.shape[-1] * 2,))
+
+
