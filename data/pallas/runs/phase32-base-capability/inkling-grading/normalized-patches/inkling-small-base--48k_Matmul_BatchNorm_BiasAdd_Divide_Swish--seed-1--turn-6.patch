+import jax
+import jax.numpy as jnp
+import jax.lax as lax
+from jax.experimental import pallas as pl
+import jax.experimental.pallas.tpu as pltpu
+
+def workload(x, weight, linear_bias, bn_scale, bn_bias, bn_mean, bn_var, bias):
+    bn_eps = 1e-05
+    divide_value = 1.0
+
+    def kernel(x_ref, w_ref, linear_bias_ref, bn_scale_ref, bn_bias_ref, bn_mean_ref, bn_var_ref, bias_ref, out_ref):
+        # Load and compute matmul in float32
+        x_f = x_ref.astype(jnp.float32)
+        w_f = w_ref.astype(jnp.float32)
+        acc = jnp.dot(x_f, w_f)
+
+        # Add linear bias
+        lb_f = linear_bias_ref.astype(jnp.float32)
+        acc = acc + lb_f
+
+        # Batch normalization
+        mean_f = bn_mean_ref.astype(jnp.float32)
+        var_f = bn_var_ref.astype(jnp.float32)
+        scale_f = bn_scale_ref.astype(jnp.float32)
+        bias_f = bn_bias_ref.astype(jnp.float32)
+
+        x_normalized = (acc - mean_f) / jnp.sqrt(var_f + 1e-05)
+        acc = scale_f * x_normalized + bias_f
+
+        # Add bias
+        b_f = bias_ref.astype(jnp.float32)
+        acc = acc + b_f
+
+        # Divide
+        acc = acc / 1.0
+
+        # Swish: x * sigmoid(x)
+        acc = acc * jnp.sigmoid(acc)
+
+        out_ref[...] = acc.astype(jnp.bfloat16)
+
+    batch_size = x.shape[0]
+    out_features = weight.shape[1]
+    block_b = 128
+    block_f = 128
+
+    grid = (batch_size // block_b, out_features // block_f)
+
+    return pl.pallas_call(
+        kernel,
+        out_shape=jax.ShapeDtypeStruct(x.shape, x.dtype),
+        grid=grid,
+        in_specs=(
+            pl.BlockSpec((block_b, x.shape[1]), lambda i, j: (i, 0)),
+            pl.BlockSpec((weight.shape[0], block_f), lambda i, j: (0, j)),
+            pl.BlockSpec((block_f,), lambda i, j: (j,)),
+            pl.BlockSpec((block_f,), lambda i, j: (j,)),
+            pl.BlockSpec((block_f,), lambda i, j: (j,)),
+            pl.BlockSpec((block_f,), lambda i, j: (j,)),
+            pl.BlockSpec((block_f,), lambda i, j: (j,)),
+            pl.BlockSpec((1,), lambda i, j: (0,)),
+        ),
+        out_specs=pl.BlockSpec((block_b, block_f), lambda i, j: (i, j)),
+        compiler_params=pltpu.CompilerParams(dimension_semantics=("parallel", "parallel")),
+    )(x, weight, linear_bias, bn_scale, bn_bias, bn_mean, bn_var, bias)
