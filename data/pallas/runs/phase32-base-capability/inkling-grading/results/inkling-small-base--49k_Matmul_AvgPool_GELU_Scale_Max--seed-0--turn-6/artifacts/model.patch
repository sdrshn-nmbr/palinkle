+            pl.BlockSpec((8192, 8192), lambda: (0, 0)),
+            pl.BlockSpec((8192,), lambda: (0,)),
+        ),
+        out_specs=pl.BlockSpec((4096,), lambda: (0,)),
+        compiler_params=pltpu.CompilerParams(dimension_semantics=("parallel",)),
+    )(x, weight, bias)
