+# Stage 1: Matmul + Bias
+# Grid over batch (4096) and out_features tiles (8192/128 = 64)
+# Each kernel computes a (1, 128) output tile
+
+def matmul_bias_kernel(x_ref, w_ref, b_ref, out_ref):
