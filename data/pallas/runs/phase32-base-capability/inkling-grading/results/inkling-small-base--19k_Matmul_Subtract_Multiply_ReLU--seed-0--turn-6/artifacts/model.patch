+import jax
+import jax.numpy as jnp
+import jax.experimental.pallas as pl
+import jax.experimental.pallas.tpu as pltpu
+
+def workload(x, weight, bias):
+    batch_size, in_features = x.shape
+    out_features = weight.shape[1]
+    block_batch = 128
+    block_out = 128
+
+    def kernel(x_ref, w_ref, b_ref, out_ref):
+        # Load tiles
+        x_tile = x_ref[...]  # (block_batch, in_features)
+        w_tile = w_ref[...]  # (in_features, block_out)
+        b_tile = b_ref[...]  # (block_out,)
+        # Compute in float32
+        x_f = x_tile.astype(jnp.float32)
+        w_f = w_tile.astype(jnp.float32)
+        out_f = jnp.dot(x_f, w_f)  # (block_batch, block_out)
+        # Add bias
+        out_f = out_f + b_tile.astype(jnp.float32)
+        # Subtract 2.0
+        out_f = out_f - 2.0
+        # Multiply 1.5
+        out_f = out_f * 1.5
+        # ReLU
+        out_f = jnp.maximum(out_f, 0.0)
+        # Write back as bfloat16
+        out_ref[...] = out_f.astype(jnp.bfloat16)
+
+    grid = (batch_size // block_batch, out_features // block_out)
+    return pl.pallas_call(
+        kernel,
+        out_shape=jax.ShapeDtypeStruct(x.shape, x.dtype),
+        grid=grid,
+        in_specs=(
+            pl.BlockSpec((block_batch, in_features), lambda i, j: (i, 0)),
+            pl.BlockSpec((in_features, block_out), lambda i, j: (0, j)),
+            pl.BlockSpec((block_out,), lambda i, j: (j,)),
+        ),
+        out_specs=pl.BlockSpec((block_batch, block_out), lambda i, j: (i, j)),
+        compiler_params=pltpu.CompilerParams(dimension_semantics=("parallel", "parallel")),
+    )(x, weight, bias)
