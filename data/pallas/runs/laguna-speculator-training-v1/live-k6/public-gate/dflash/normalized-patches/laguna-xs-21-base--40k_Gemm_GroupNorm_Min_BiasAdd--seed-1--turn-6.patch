+import jax
+import jax.numpy as jnp
+import jax.pallas as pl
+import jax.pallas as plp
+import jax.interpreters.tpu as pltpu
+
+def workload(x, weight, linear_bias, gn_weight, gn_bias, bias):
+    """Gemm + GroupNorm + Min + BiasAdd kernel."""
+
+    # Constants
+    num_groups = 512
+    eps = 1e-5
+
+    # Matmul: x @ weight + linear_bias
+    x = jnp.dot(x, weight, precision=jax.lax.Precision.HIGHEST)
+    x = x + linear_bias
+
+    # Get shapes
+    N, C = x.shape
+    G = num_groups
+
+    # Reshape for group norm: (N, G, C//G)
+    x = x.reshape(N, G, C // G)
+
+    # Group normalization
+    mean = jnp.mean(x, axis=2, keepdims=True)
+    var = jnp.var(x, axis=2, keepdims=True)
+    x = (x - mean) / jnp.sqrt(var + eps)
+
+    # Reshape back: (N, C)
+    x = x.reshape(N, C)
+
+    # Scale and shift
+    x = x * gn_weight + gn_bias
+
+    # Min along axis 1
+    x = jnp.min(x, axis=1, keepdims=True)
+
+    # Reshape to output shape
+    x = x.reshape(1, 1, N, 1)
+
+    # Add bias
+    x = x + bias
+
+    return x
