+import jax
+import jax.numpy as jnp
+import jax.pallas as pl
+import jax.pallas as plp
+import jax.pallas.lib as pllib
+import jax.interpreters.pallas as pallas
+from jax.interpreters import xla_extension as pltpu
+
+def workload(pair_act, mask, left_proj_w, right_proj_w, left_gate_w, right_gate_w, center_scale, out_proj_w, out_gate_w):
+    """Triangle Multiplicative Update (Outgoing) kernel for AlphaFold2."""
+
+    # Constants
+    eps = 1e-6
+
+    # Step 1: act = pair_act * mask
+    act = pair_act * mask
+
+    # Step 2: left_proj = dot(act, left_proj_w)
+    left_proj = jnp.dot(act, left_proj_w)
+
+    # Step 3: right_proj = dot(act, right_proj_w)
+    right_proj = jnp.dot(act, right_proj_w)
+
+    # Step 4: left_gate = sigmoid(dot(act, left_gate_w))
+    left_gate = jax.nn.sigmoid(jnp.dot(act, left_gate_w))
+
+    # Step 5: right_gate = sigmoid(dot(act, right_gate_w))
+    right_gate = jax.nn.sigmoid(jnp.dot(act, right_gate_w))
+
+    # Step 6: left_proj = left_proj * left_gate
+    left_proj = left_proj * left_gate
+
+    # Step 7: right_proj = right_proj * right_gate
+    right_proj = right_proj * right_gate
+
+    # Step 8: result = einsum("ikc,jkc->ijc", left_proj, right_proj)
+    result = jnp.einsum("ikc,jkc->ijc", left_proj, right_proj)
+
+    # Step 9: rms = sqrt(mean(result**2, axis=-1, keepdims=True) + eps)
+    rms = jnp.sqrt(jnp.mean(result * result, axis=-1, keepdims=True) + eps)
+
+    # Step 10: result = (result / rms) * center_scale
+    result = (result / rms) * center_scale
+
+    # Step 11: output = dot(result, out_proj_w)
+    output = jnp.dot(result, out_proj_w)
+
+    # Step 12: gate = sigmoid(dot(pair_act, out_gate_w))
+    gate = jax.nn.sigmoid(jnp.dot(pair_act, out_gate_w))
+
+    # Step 13: return output * gate
+    return output * gate
