+import jax
+import jax.numpy as jnp
+import jax.pallas as pl
+import jax.pallas as plp
+import jax.interpreters.tpu as pltpu
+
+
+def matmul_dropout_softmax_kernel(
+    x_ref,
+    weight_ref,
+    bias_ref,
+    out_ref,
+):
+    """Pallas kernel for Matmul + Softmax."""
+    m = x_ref.shape[0]
+    n = weight_ref.shape[1]
+    k = weight_ref.shape[0]
+
+    # Get the current block indices
+    row_block = pl.program_id(0)
+    col_block = pl.program_id(1)
+
+    # Block sizes
+    block_m = x_ref.shape[0] // pl.grid_size(0) if pl.grid_size(0) > 0 else m
+    block_n = out_ref.shape[1] // pl.grid_size(1) if pl.grid_size(1) > 0 else n
+
+    # Compute the matmul result for this block
+    # Accumulate in float32 for better precision
+    acc = jnp.zeros((block_m, block_n), dtype=jnp.float32)
+
+    for k_block in range(0, k, 128):
+        # Load x block [block_m, 128]
+        x_block = x_ref[
+            row_block * block_m : (row_block + 1) * block_m,
+            k_block : k_block + 128
+        ]
+        # Load weight block [128, block_n] - transposed
+        weight_block = weight_ref[
+            k_block : k_block + 128,
+            col_block * block_n : (col_block + 1) * block_n
+        ]
+
+        # Compute partial matmul and accumulate
+        acc = acc + jnp.dot(x_block.astype(jnp.float32), weight_block.astype(jnp.float32))
+
+    # Add bias
+    bias_block = bias_ref[col_block * block_n : (col_block + 1) * block_n]
+    acc = acc + bias_block
+
+    # Apply softmax along axis 1 (columns)
+    # For numerical stability, subtract max
+    acc_max = jnp.max(acc, axis=1, keepdims=True)
+    acc_shifted = acc - acc_max
+    exp_acc = jnp.exp(acc_shifted)
+    sum_exp = jnp.sum(exp_acc, axis=1, keepdims=True)
+    softmax_result = exp_acc / sum_exp
+
+    # Store result back as bfloat16
+    out_ref[
+        row_block * block_m : (row_block + 1) * block_m,
+        col_block * block_n : (col_block + 1) * block_n
+    ] = softmax_result.astype(out_ref.dtype)
+
+
+def workload(x, weight, bias):
+    """Matmul + Dropout (skipped in inference) + Softmax workload."""
+    batch_size = x.shape[0]
+    out_features = weight.shape[1]
+
+    # Use block sizes that are multiples of 8 for bf16
+    block_m = 128
+    block_n = 128
+    block_k = 128
+
+    # Grid dimensions
+    grid_m = (batch_size + block_m - 1) // block_m
+    grid_n = (out_features + block_n - 1) // block_n
+
+    return pl.pallas_call(
+        matmul_dropout_softmax_kernel,
+        out_shape=jax.ShapeDtypeStruct(x.shape, x.dtype),
+        grid=(grid_m, grid_n),
+        in_specs=(
+            pl.BlockSpec((batch_size, weight.shape[0]), lambda _: (0, 0)),
+            pl.BlockSpec((weight.shape[0], out_features), lambda _: (0, 0)),
+            pl.BlockSpec((out_features,), lambda _: (0,)),
+        ),
+        out_specs=pl.BlockSpec((batch_size, out_features), lambda _: (0, 0)),
+        compiler_params=pltpu.CompilerParams(
+            dimension_semantics=("parallel", "parallel")
+        ),
+    )(x, weight, bias)
