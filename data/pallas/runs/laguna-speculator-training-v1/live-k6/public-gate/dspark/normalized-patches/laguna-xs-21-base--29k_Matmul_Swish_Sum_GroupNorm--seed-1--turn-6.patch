+import jax
+import jax.numpy as jnp
+import jax.pallas as pl
+import jax.interpreters.tpu as pltpu
+
+
+def workload(x, weight, bias, gn_weight, gn_bias):
+    """TPU Pallas kernel for Matmul + Swish + Sum(bias) + GroupNorm."""
+    batch_size = 8192
+    in_features = 4096
+    out_features = 4096
+    num_groups = 64
+    group_size = out_features // num_groups  # 64
+
+    # Block size for tiling - use multiples of 8 for bf16
+    block_m = 128  # batch dimension
+    block_n = 128  # output feature dimension
+
+    def kernel(x_ref, weight_ref, bias_ref, gn_weight_ref, gn_bias_ref, out_ref, m_idx, n_idx):
+        # Initialize accumulator in float32 for matmul
+        acc = jnp.zeros((block_m, block_n), dtype=jnp.float32)
+
+        # Matmul: x @ weight
+        # Tile over the reduction dimension (in_features)
+        for k in range(in_features // block_n):
+            x_block = x_ref[:, k * block_n:(k + 1) * block_n].astype(jnp.float32)
+            w_block = weight_ref[k * block_n:(k + 1) * block_n, :].astype(jnp.float32)
+            acc = acc + jnp.dot(x_block, w_block)
+
+        # Convert back to bfloat16
+        x_out = acc.astype(jnp.bfloat16)
+
+        # Swish activation: x * sigmoid(x)
+        x_out = x_out * jax.nn.sigmoid(x_out)
+
+        # Add bias
+        x_out = x_out + bias_ref
+
+        # Reshape for group norm: (batch, num_groups, group_size)
+        x_reshaped = x_out.reshape(batch_size, num_groups, group_size)
+
+        # Compute mean and variance along last axis
+        mean = jnp.mean(x_reshaped, axis=-1, keepdims=True)
+        var = jnp.var(x_reshaped, axis=-1, keepdims=True)
+
+        # Normalize
+        x_norm = (x_reshaped - mean) / jnp.sqrt(var + 1e-5)
+
+        # Reshape back
+        x_out = x_norm.reshape(batch_size, out_features)
+
+        # Apply group norm parameters
+        out_ref[...] = x_out * gn_weight_ref + gn_bias_ref
+
+    # Grid dimensions
+    grid_m = batch_size // block_m
+    grid_n = out_features // block_n
+
+    return pl.pallas_call(
+        kernel,
+        out_shape=jax.ShapeDtypeStruct((batch_size, out_features), jnp.bfloat16),
+        grid=(grid_m, grid_n),
+        in_specs=(
+            pl.BlockSpec((batch_size, in_features), lambda m, n: (0, 0)),
+            pl.BlockSpec((in_features, out_features), lambda m, n: (0, 0)),
+            pl.BlockSpec((out_features,), lambda m, n: (0,)),
+            pl.BlockSpec((out_features,), lambda m, n: (0,)),
+            pl.BlockSpec((out_features,), lambda m, n: (0,)),
+        ),
+        out_specs=pl.BlockSpec((block_m, block_n), lambda m, n: (m * block_m, n * block_n)),
+        compiler_params=pltpu.CompilerParams(
+            dimension_semantics=("parallel", "parallel")
+        ),
+    )(x, weight, bias, gn_weight, gn_bias)
