+            for f in range(block_n):
+                if m_offset + b < batch_size and n_offset + f < out_features:
+                    # Get the feature index
+                    feat_idx = n_offset + f
+                    group_idx = feat_idx // group_size
+                    group_start = group_idx * group_size
+                    group_end = group_start + group_size
+                    
+                    # For group norm, we need all features in the group
