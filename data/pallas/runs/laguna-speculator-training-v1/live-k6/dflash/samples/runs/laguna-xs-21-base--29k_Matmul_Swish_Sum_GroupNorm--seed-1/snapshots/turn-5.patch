+    3. y = y + bias
+    4. Reshape to [batch, num_groups, group_size] where group_size = 4096/64 = 64
+    5. GroupNorm: normalize across group_size dimension
+    6. Apply gn_weight and gn_bias
+    """
+    batch_size = x.shape[0]
+    in_features = x.shape[1]
+    out_features = weight.shape[1]
+    num_groups = 64
