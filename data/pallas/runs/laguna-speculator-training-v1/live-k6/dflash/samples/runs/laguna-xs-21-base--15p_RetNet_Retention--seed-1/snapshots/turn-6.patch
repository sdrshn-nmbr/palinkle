+def workload_pallas(query, key, value):
+    """
+    Multi-scale retention kernel using Pallas for TPU.
+    """
+    B, H, S, D = query.shape
+    
+    # Block size for tiling
+    block_s = 64  # Tile along sequence dimension
+    block_d = 32  # Tile along head dimension
+    
+    def retention_kernel(ref_q, ref_k, ref_v, ref_out, 
+                         gammas, log_gamma, positions, distance, causal_mask,
+                         b_idx, h_idx, s_idx, d_idx):
+        # Get head-specific gamma
+        gamma = gammas[h_idx]
+        lg = log_gamma[h_idx]
+        
+        # Compute decay for current position
+        dist = distance[s_idx, :]  # Distance from current position to all positions
+        decay = jnp.exp(lg * jnp.maximum(dist, 0.0)) * causal_mask[s_idx, :]
+        
+        # Compute QK for current position
+        q = ref_q[b_idx, h_idx, s_idx, :]  # [D]
+        k_all = ref_k[b_idx, h_idx, :, :]  # [S, D]
+        
+        # QK^T: sum over D
+        qk = jnp.sum(q * k_all, axis=-1)  # [S]
+        
+        # Apply decay
+        qk_decayed = qk * decay
+        
+        # Retention sum for normalization
+        retention_sum = jnp.maximum(jnp.abs(qk_decayed), 1.0).sum()
+        
+        # Normalize
+        qk_norm = qk_decayed / retention_sum
+        
+        # Compute output: sum over S
+        v_all = ref_v[b_idx, h_idx, :, :]  # [S, D]
+        output = jnp.sum(qk_norm[:, None] * v_all, axis=0)  # [D]
+        
+        ref_out[b_idx, h_idx, s_idx, d_idx] = output.astype(ref_q.dtype)
+    
+    # Precompute constants
+    gammas = jnp.exp2(1.0 - 5.0 / jnp.arange(H, dtype=jnp.float32))
+    log_gamma = jnp.log(gammas)
+    positions = jnp.arange(S, dtype=jnp.float32)
+    distance = positions[:, None] - positions[None, :]
+    causal_mask = (distance >= 0).astype(jnp.float32)
+    
+    return pl.pallas_call(
+        retention_kernel,
+        out_shape=jax.ShapeDtypeStruct(query.shape, query.dtype),
+        grid=(B, H, (S + block_s - 1) // block_s, (D + block_d - 1) // block_d),
+        in_specs=(
+            pl.BlockSpec((1, 1, block_s, D), lambda b, h, s, d: (b, h, s * block_s, 0)),
+            pl.BlockSpec((1, 1, S, D), lambda b, h, s, d: (b, h, 0, 0)),
+            pl.BlockSpec((1, 1, S, D), lambda b, h, s, d: (b, h, 0, 0)),
+        ),
+        out_specs=pl.BlockSpec((1, 1, block_s, block_d), lambda b, h, s, d: (b, h, s * block_s, d * block_d)),
+        compiler_params=pltpu.CompilerParams(
+            dimension_semantics=("parallel", "parallel", "sequential", "parallel")
+        ),
+    )(query, key, value, gammas, log_gamma, positions, distance, causal_mask)
+
