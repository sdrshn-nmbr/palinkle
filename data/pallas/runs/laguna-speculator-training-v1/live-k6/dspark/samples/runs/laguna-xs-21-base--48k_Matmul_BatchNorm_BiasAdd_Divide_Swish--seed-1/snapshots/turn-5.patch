+import jax
+import jax.numpy as jnp
+import jax.pallas as pl
+import jax.pallas as plp
+import jax.interpreters.tpu as pltpu
+
+def workload(x, weight, linear_bias, bn_scale, bn_bias, bn_mean, bn_var, bias):
+    """
+    Matmul + BatchNorm + BiasAdd + Divide + Swish
+    """
+    batch_size = x.shape[0]  # 4096
+    out_features = x.shape[1]  # 8192
+    
+    # Block size for TPU - multiples of 8 for bf16
+    block_size = 128
+    
+    def kernel(ref_x, ref_weight, ref_linear_bias, ref_bn_scale, ref_bn_bias, 
+               ref_bn_mean, ref_bn_var, ref_bias, out_ref):
+        # Get program indices
+        m_idx = pl.program_id(0)
+        n_idx = pl.program_id(1)
+        
+        # Compute tile bounds
+        m_start = m_idx * block_size
+        n_start = n_idx * block_size
+        m_end = min(m_start + block_size, batch_size)
+        n_end = min(n_start + block_size, out_features)
+        
+        # Initialize accumulator in float32
+        acc = jnp.zeros((m_end - m_start, n_end - n_start), dtype=jnp.float32)
+        
+        # Matmul: x @ weight + linear_bias
+        # x has shape [batch_size, in_features], weight has shape [in_features, out_features]
+        # We need to tile along the reduction dimension (in_features = 8192)
+        in_features = ref_weight.shape[0]
+        reduce_block = 128
+        
+        for k_start in range(0, in_features, reduce_block):
+            k_end = min(k_start + reduce_block, in_features)
+            
+            # Load x tile [m, k]
+            x_tile = ref_x[m_start:m_end, k_start:k_end]
+            # Load weight tile [k, n]
+            w_tile = ref_weight[k_start:k_end, n_start:n_end]
+            
+            # Accumulate in float32
+            acc = acc + jnp.dot(x_tile.astype(jnp.float32), w_tile.astype(jnp.float32))
+        
+        # Add linear bias
+        bias_tile = ref_linear_bias[n_start:n_end]
+        acc = acc + bias_tile.astype(jnp.float32)
+        
+        # Convert to bf16 for subsequent operations
+        x_out = acc.astype(jnp.bfloat16)
+        
+        # BatchNorm: (x - mean) / sqrt(var + eps) * scale + bias
+        bn_eps = 1e-5
+        bn_scale_tile = ref_bn_scale[n_start:n_end]
+        bn_bias_tile = ref_bn_bias[n_start:n_end]
+        bn_mean_tile = ref_bn_mean[n_start:n_end]
+        bn_var_tile = ref_bn_var[n_start:n_end]
+        
+        x_normalized = (x_out - bn_mean_tile) / jnp.sqrt(bn_var_tile + bn_eps)
+        x_out = x_normalized * bn_scale_tile + bn_bias_tile
+        
+        # Add bias
+        bias_val = ref_bias[0]
+        x_out = x_out + bias_val
+        
+        # Divide by 1.0
+        divide_value = 1.0
+        x_out = x_out / divide_value
+        
+        # Swish: x * sigmoid(x)
+        x_out = x_out * jax.nn.sigmoid(x_out)
+        
+        # Write output
+        out_ref[...] = x_out
+    
+    # Grid dimensions
+    num_m_blocks = (batch_size + block_size - 1) // block_size
+    num_n_blocks = (out_features + block_size - 1) // block_size
+    
+    return pl.pallas_call(
+        kernel,
+        out_shape=jax.ShapeDtypeStruct((batch_size, out_features), jnp.bfloat16),
+        grid=(num_m_blocks, num_n_blocks),
+        in_specs=(
+            pl.BlockSpec((batch_size, in_features), lambda: (0, 0)),
+            pl.BlockSpec((in_features, out_features), lambda: (0, 0)),
+            pl.BlockSpec((out_features,), lambda: (0,)),
+            pl.BlockSpec((out_features,), lambda: (0,)),
+            pl.BlockSpec((out_features,), lambda: (0,)),
+            pl.BlockSpec((out_features,), lambda: (0,)),
+            pl.BlockSpec((out_features,), lambda: (0,)),
+            pl.BlockSpec((1,), lambda: (0,)),
+        ),
+        out_specs=pl.BlockSpec((block_size, block_size), lambda m, n: (m * block_size, n * block_size)),
+        compiler_params=pltpu.CompilerParams(
+            dimension_semantics=("parallel", "parallel")
+        ),
+    )(x, weight, linear_bias, bn_scale, bn_bias, bn_mean, bn_var, bias)
