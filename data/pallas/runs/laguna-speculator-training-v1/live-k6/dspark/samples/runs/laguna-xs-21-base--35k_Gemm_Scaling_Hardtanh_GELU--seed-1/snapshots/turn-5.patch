+import jax
+import jax.numpy as jnp
+import jax.pallas as pl
+import jax.pallas as plp
+import jax.interpreters.tpu as pltpu
+
+def workload(x, weight, bias):
+    """GEMM + Scaling + Hardtanh + GELU kernel."""
+    
+    # Block size for tiling - use multiples of 8 for bf16
+    block_m = 128
+    block_k = 128
+    block_n = 128
+    
+    # Grid dimensions
+    grid_m = x.shape[0] // block_m
+    grid_n = x.shape[1] // block_n
+    
+    def kernel(ref_x, ref_weight, ref_bias, out_ref):
+        # Accumulator in float32 for better precision
+        acc = jnp.zeros((block_m, block_n), dtype=jnp.float32)
+        
+        # Tile over K dimension
+        for k in range(ref_weight.shape[1] // block_k):
+            # Load blocks
+            x_block = ref_x[k * block_k:(k + 1) * block_k].astype(jnp.float32)
+            w_block = ref_weight[:, k * block_k:(k + 1) * block_k].astype(jnp.float32)
+            
+            # GEMM: accumulate x @ weight
+            acc = acc + jnp.dot(x_block, w_block)
+        
+        # Add bias (broadcast along first dimension)
+        acc = acc + ref_bias.astype(jnp.float32)
+        
+        # Scale by 0.5
+        acc = acc * 0.5
+        
+        # Hardtanh: clip to [-2, 2]
+        acc = jnp.clip(acc, -2.0, 2.0)
+        
+        # GELU approximation: 0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))
+        sqrt_2_over_pi = jnp.sqrt(2.0 / jnp.pi)
+        gelu_inner = sqrt_2_over_pi * (acc + 0.044715 * jnp.power(acc, 3))
+        gelu = 0.5 * acc * (1.0 + jnp.tanh(gelu_inner))
+        
+        # Write output as bfloat16
+        out_ref[...] = gelu.astype(jnp.bfloat16)
+    
+    return pl.pallas_call(
+        kernel,
+        out_shape=jax.ShapeDtypeStruct(x.shape, x.dtype),
+        grid=(grid_m, grid_n),
+        in_specs=(
+            pl.BlockSpec((block_m, block_k), lambda i, j: (i * block_m, 0)),
+            pl.BlockSpec((block_k, block_n), lambda i, j: (0, j * block_n)),
+            pl.BlockSpec((block_n,), lambda i, j: (j * block_n,)),
+        ),
+        out_specs=pl.BlockSpec((block_m, block_n), lambda i, j: (i * block_m, j * block_n)),
+        compiler_params=pltpu.CompilerParams(
+            dimension_semantics=("parallel", "parallel")
+        ),
+    )(x, weight, bias)
