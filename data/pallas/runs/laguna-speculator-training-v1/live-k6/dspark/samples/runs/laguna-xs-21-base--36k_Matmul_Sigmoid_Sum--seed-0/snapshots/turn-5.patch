+import jax
+import jax.numpy as jnp
+import jax.pallas as pl
+import jax.pallas as plp
+import jax.interpreters.tpu as pltpu
+
+
+def workload(x, weight, bias):
+    """Compute matmul(x, weight) + bias, apply sigmoid, then sum along axis 1."""
+    
+    M, K = x.shape
+    K2, N = weight.shape
+    
+    # Output shape after matmul is (M, N), then sigmoid, then sum -> (M, 1)
+    out_shape = jax.ShapeDtypeStruct((M, 1), x.dtype)
+    
+    # Block sizes optimized for TPU bf16
+    block_m = 128
+    block_k = 128
+    block_n = 128
+    
+    def matmul_sigmoid_sum_kernel(
+        x_ref,
+        weight_ref,
+        bias_ref,
+        out_ref,
+    ):
+        # Grid indices
+        m_block = pl.program_id(0)
+        
+        # Compute matmul result in float32 for accumulation
+        # We need to compute the full row of matmul result
+        # x[m_block*block_m:(m_block+1)*block_m, :] @ weight[:, :]
+        
+        # Initialize accumulator for matmul result
+        # Result shape: (block_m, N)
+        acc = jnp.zeros((block_m, N), dtype=jnp.float32)
+        
+        # Tile over K dimension
+        for k_block in range(K // block_k):
+            # Load blocks
+            x_block = x_ref[
+                m_block * block_m:(m_block + 1) * block_m,
+                k_block * block_k:(k_block + 1) * block_k,
+            ]
+            weight_block = weight_ref[
+                k_block * block_k:(k_block + 1) * block_k,
+                :,
+            ]
+            
+            # Convert to float32 for accumulation
+            x_block_f32 = x_block.astype(jnp.float32)
+            weight_block_f32 = weight_block.astype(jnp.float32)
+            
+            # Accumulate matmul
+            acc = acc + jnp.dot(x_block_f32, weight_block_f32)
+        
+        # Handle remaining K dimension if not divisible
+        if K % block_k != 0:
+            k_blocks = K // block_k
+            x_block = x_ref[
+                m_block * block_m:(m_block + 1) * block_m,
+                k_blocks * block_k:K,
+            ]
+            weight_block = weight_ref[
+                k_blocks * block_k:K,
+                :,
+            ]
+            x_block_f32 = x_block.astype(jnp.float32)
+            weight_block_f32 = weight_block.astype(jnp.float32)
+            acc = acc + jnp.dot(x_block_f32, weight_block_f32)
+        
+        # Add bias (broadcast along M dimension)
+        bias_block = bias_ref[:]
+        acc = acc + bias_block
+        
+        # Convert back to bfloat16 for sigmoid
+        acc_bf16 = acc.astype(jnp.bfloat16)
+        
+        # Apply sigmoid
+        sig_result = jax.nn.sigmoid(acc_bf16)
+        
+        # Sum along axis 1 (N dimension) with keepdims
+        sum_result = jnp.sum(sig_result, axis=1, keepdims=True)
+        
+        # Write output
+        out_ref[m_block * block_m:(m_block + 1) * block_m, :] = sum_result
+    
+    # Grid: one block per M dimension
+    grid = (M // block_m,)
+    
+    return pl.pallas_call(
+        matmul_sigmoid_sum_kernel,
+        out_shape=out_shape,
+        grid=grid,
+        in_specs=(
+            pl.BlockSpec((block_m, block_k), lambda mi, vi: (mi * block_m, 0)),
+            pl.BlockSpec((block_k, N), lambda mi, vi: (0, 0)),
+            pl.BlockSpec((N,), lambda mi, vi: (0,)),
+        ),
+        out_specs=pl.BlockSpec((block_m, 1), lambda mi, vi: (mi * block_m, 0)),
+        compiler_params=pltpu.CompilerParams(
+            dimension_semantics=("parallel",)
+        ),
+    )(x, weight, bias)
