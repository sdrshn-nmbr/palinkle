+import jax
+import jax.numpy as jnp
+import jax.pallas as pl
+import jax.pallas.lib as pllib
+import jax.pallas.tpu as pltpu
+
+def workload(x, weight, bias, gn_weight, gn_bias):
+    """Matmul + Swish + Sum(bias) + GroupNorm kernel."""
+    batch_size = x.shape[0]
+    in_features = x.shape[1]
+    out_features = weight.shape[1]
+    num_groups = 64
+    group_size = out_features // num_groups
+    
+    # Block size for tiling
+    BLOCK_M = 128
+    BLOCK_N = 128
+    BLOCK_K = 64
+    
+    def kernel(matmul_out_ref, x_ref, bias_ref, gn_weight_ref, gn_bias_ref, 
+               mean_out_ref, var_out_ref):
+        # Compute matmul result
+        m = pl.program_id(0)
+        n = pl.program_id(1)
+        
+        # Accumulate matmul in float32
+        acc = jnp.zeros((BLOCK_M, BLOCK_N), dtype=jnp.float32)
+        
+        for k in range(0, in_features, BLOCK_K):
+            k_end = min(k + BLOCK_K, in_features)
+            x_block = x_ref[m * BLOCK_M:(m + 1) * BLOCK_M, k:k_end].astype(jnp.float32)
+            w_block = weight_ref[k:k_end, n * BLOCK_N:(n + 1) * BLOCK_N].astype(jnp.float32)
+            acc = acc + jnp.dot(x_block, w_block)
+        
+        # Store matmul result
+        matmul_out_ref[m * BLOCK_M:(m + 1) * BLOCK_M, n * BLOCK_N:(n + 1) * BLOCK_N] = acc.astype(jnp.bfloat16)
+    
+    # Grid for matmul
+    grid_m = (batch_size + BLOCK_M - 1) // BLOCK_M
+    grid_n = (out_features + BLOCK_N - 1) // BLOCK_N
+    
+    # First compute matmul
+    matmul_out = pl.pallas_call(
+        kernel,
+        out_shape=jax.ShapeDtypeStruct((batch_size, out_features), jnp.bfloat16),
+        grid=(grid_m, grid_n),
+        in_specs=(
+            pl.BlockSpec((batch_size, in_features), lambda: (0, 0)),
+            pl.BlockSpec((in_features, out_features), lambda: (0, 0)),
+        ),
+        out_specs=pl.BlockSpec((batch_size, out_features), lambda: (0, 0)),
+        compiler_params=pltpu.CompilerParams(
+            dimension_semantics=("parallel", "parallel")
+        ),
+    )(x, weight)
+    
+    # Apply Swish: x * sigmoid(x)
+    x_swish = matmul_out * jax.nn.sigmoid(matmul_out)
+    
+    # Add bias
+    x_bias = x_swish + bias
+    
+    # Group normalization
+    # Reshape to (batch_size, num_groups, group_size)
+    x_reshaped = x_bias.reshape(batch_size, num_groups, group_size)
+    
+    # Compute mean and variance along last axis
+    mean = jnp.mean(x_reshaped, axis=-1, keepdims=True)
+    var = jnp.var(x_reshaped, axis=-1, keepdims=True)
+    
+    # Normalize
+    x_norm = (x_reshaped - mean) / jnp.sqrt(var + 1e-5)
+    
+    # Reshape back and apply scale/shift
+    x_norm = x_norm.reshape(batch_size, out_features)
+    output = x_norm * gn_weight + gn_bias
+    
+    return output.astype(jnp.bfloat16)
