+import jax
+import jax.numpy as jnp
+import jax.pallas as pl
+import jax.pallas as plp
+import jax.interpreters.tpu as pltpu
+
+
+def workload(x, weights):
+    """Grouped matmul (ragged dot) for MoE - Mixtral 8x7B.
+    
+    Computes: out[g, m, n] = sum_k x[g, m, k] * weights[g, k, n]
+    for each group g in [0, num_groups).
+    """
+    # Get shapes
+    num_groups = x.shape[0]
+    m = x.shape[1]  # 1024
+    k = x.shape[2]  # 4096
+    n = weights.shape[2]  # 14336
+    
+    # Block sizes - TPU requires multiples of 8 for bf16
+    block_m = 128
+    block_k = 128
+    block_n = 128
+    
+    def matmul_kernel(
+        x_ref,
+        weights_ref,
+        out_ref,
+    ):
+        # Get program IDs for 3D grid
+        g = pl.program_id(0)  # group
+        m_block = pl.program_id(1)  # m block
+        n_block = pl.program_id(2)  # n block
+        
+        # Compute tile offsets
+        m_start = m_block * block_m
+        n_start = n_block * block_n
+        
+        # Accumulator in float32
+        acc = jnp.zeros((block_m, block_n), dtype=jnp.float32)
+        
+        # Loop over k dimension
+        for k_block in range(k // block_k):
+            k_start = k_block * block_k
+            
+            # Load tiles
+            x_tile = x_ref[
+                g,
+                m_start : m_start + block_m,
+                k_start : k_start + block_k,
+            ]
+            w_tile = weights_ref[
+                g,
+                k_start : k_start + block_k,
+                n_start : n_start + block_n,
+            ]
+            
+            # Compute partial matmul and accumulate
+            acc = acc + jnp.dot(x_tile, w_tile)
+        
+        # Store result (convert back to bfloat16)
+        out_ref[g, m_start : m_start + block_m, n_start : n_start + block_n] = acc.astype(jnp.bfloat16)
+    
+    # Grid dimensions
+    grid_m = (m + block_m - 1) // block_m
+    grid_n = (n + block_n - 1) // block_n
+    
+    return pl.pallas_call(
+        matmul_kernel,
+        out_shape=jax.ShapeDtypeStruct(x.shape, x.dtype),
+        grid=(num_groups, grid_m, grid_n),
+        in_specs=(
+            pl.BlockSpec((num_groups, m, k), lambda g, m_b, n_b: (g, 0, 0)),
+            pl.BlockSpec((num_groups, k, n), lambda g, m_b, n_b: (g, 0, 0)),
+        ),
+        out_specs=pl.BlockSpec((num_groups, m, n), lambda g, m_b, n_b: (g, 0, 0)),
+        compiler_params=pltpu.CompilerParams(
+            dimension_semantics=("parallel", "parallel", "parallel")
+        ),
+    )(x, weights)
